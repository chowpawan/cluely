{
  "name": "claude-sticky",
  "version": "1.0.0",
  "description": "A small, transparent sticky-note window for Claude",
  "author": "chowpawan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dir",
    "dist:win": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.chowpawan.claudesticky",
    "productName": "Claude Sticky",
    "files": [
      "main.js",
      "index.html",
      "iconTemplate.png"
    ],
    "publish": {
      "provider": "github",
      "owner": "chowpawan",
      "repo": "cluely"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
