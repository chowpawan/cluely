{
  "name": "claude-sticky",
  "version": "1.0.0",
  "description": "A small, transparent sticky-note window for Claude",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.chowpawan.claudesticky",
    "productName": "Claude Sticky",
    "files": [
      "main.js",
      "index.html",
      "iconTemplate.png"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "identity": null
    }
  }
}
